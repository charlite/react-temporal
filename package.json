{
  "name": "@charlite/react-temporal",
  "version": "1.1.1",
  "description": "React hooks for date and time using the JavaScript Temporal API — native in modern browsers and Node.js 26+, polyfill-ready elsewhere.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "dev": "pwsh -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:test": "pwsh -ExecutionPolicy Bypass -File scripts/dev.ps1 -Task test",
    "dev:build": "pwsh -ExecutionPolicy Bypass -File scripts/dev.ps1 -Task build",
    "dev:lint": "pwsh -ExecutionPolicy Bypass -File scripts/dev.ps1 -Task lint",
    "dev:typecheck": "pwsh -ExecutionPolicy Bypass -File scripts/dev.ps1 -Task typecheck",
    "prepublishOnly": "npm run build && npm run test && npm run lint && npm run typecheck",
    "setup": "node scripts/setup.js",
    "setup:ps": "pwsh -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "release": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:ps": "pwsh -ExecutionPolicy Bypass -File scripts/release.ps1",
    "release:ps:minor": "pwsh -ExecutionPolicy Bypass -File scripts/release.ps1 -VersionType minor",
    "release:ps:major": "pwsh -ExecutionPolicy Bypass -File scripts/release.ps1 -VersionType major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlite/react-temporal.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/charlite/react-temporal#readme",
  "bugs": {
    "url": "https://github.com/charlite/react-temporal/issues"
  },
  "keywords": [
    "react",
    "react-hooks",
    "temporal",
    "temporal-api",
    "date",
    "time",
    "calendar",
    "timezone",
    "hooks",
    "datetime",
    "javascript",
    "intl",
    "polyfill",
    "okf"
  ],
  "author": {
    "name": "charlite",
    "email": "38315638+charlite@users.noreply.github.com",
    "url": "https://github.com/charlite"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.52.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "temporal-polyfill": "^1.0.5",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@js-temporal/polyfill": {
      "optional": true
    },
    "temporal-polyfill": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "temporal-polyfill": "^1.0.5"
  }
}
